{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtolhuijs.nl/news-radar/schemas/setup-news-v1.schema.json",
  "title": "Omarchy News Radar setup activity companion v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "publishedAt", "plugins", "events"],
  "properties": {
    "schemaVersion": {"const": 1},
    "publishedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "plugins": {
      "type": "array",
      "maxItems": 5000,
      "items": {"$ref": "#/$defs/plugin"}
    },
    "events": {
      "type": "array",
      "maxItems": 500,
      "items": {"$ref": "feed-v2.schema.json#/$defs/event"}
    }
  },
  "$defs": {
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "repository", "sourceUrl", "addedAt", "listingDated", "verification", "retired", "tags"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,159}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "description": {"type": "string", "minLength": 1, "maxLength": 400},
        "version": {"type": "string", "minLength": 1, "maxLength": 80},
        "repository": {"type": "string", "format": "uri", "pattern": "^https://"},
        "sourceUrl": {"type": "string", "format": "uri", "pattern": "^https://"},
        "addedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "listingDated": {"const": true},
        "verification": {"enum": ["verified", "reviewed", "unverified", "unknown"]},
        "retired": {"const": false},
        "tags": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"}
        },
        "image": {"$ref": "feed-v2.schema.json#/$defs/event/properties/image"}
      }
    }
  }
}
